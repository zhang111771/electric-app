# ===== LLM（必须配置 API Key 才能运行）=====
# 默认使用 DeepSeek（OpenAI 兼容接口），可换成 Qwen/智谱/硅基流动等
# 注意：这里是模板，真实 key 只写在 .env（被 .dockerignore 和打包脚本排除，不离开本机）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-请填入你的真实key
LLM_MODEL=deepseek-chat

# ===== 知识库检索 =====
# EMBEDDING_MODE 可选:
#   pgvector  推荐：本地 Ollama bge-m3 编码，向量存 PostgreSQL pgvector 表（完全离线可用）
#   tfidf     纯 Python 词频，零依赖零费用，开箱即用（兜底）
#   api       调用 OpenAI 兼容 Embedding 接口、向量存 kb_index.json（旧方案）
EMBEDDING_MODE=pgvector
# 本地 Ollama 的 OpenAI 兼容端点；也可换成硅基流动 https://api.siliconflow.cn/v1 等
EMBEDDING_BASE_URL=http://localhost:11434/v1
# Ollama 不校验 key，占位即可；用外部 API 时填真实 key
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
# pgvector 知识库向量表（bge-m3 向量维度 1024，改模型需同步改）
KB_VECTOR_TABLE=kb_chunks
KB_VECTOR_DIM=1024

# ===== PostgreSQL（模拟台账/负荷/告警 + 多轮对话记忆持久化）=====
# 需要本地已安装并启动 PostgreSQL（参考 xhs_langgraph 项目配置，默认账号 postgres）
# 首次运行 generate_data.py 会自动创建数据库（默认 electric_power）
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/electric_power

# ===== LangSmith 链路追踪（可选，用于观测 LangGraph 每次运行的输入/输出/耗时）=====
LANGSMITH_API_KEY=lsv2_请填入你的真实key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=electric_langgraph
