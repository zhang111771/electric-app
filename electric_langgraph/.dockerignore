.git
.gitignore
.claude
.idea
.vscode

# ===== Python 缓存 =====
__pycache__
*.pyc
*.pyo

# ===== 本地开发痕迹 / 大体积无关目录 =====
.tmp_pgv
bundle
screenshot
docs
# 迁移打包产物（scripts/package_deploy.sh 生成）
deploy_package.tar.gz
# 知识库全文语料（体积大，需要时自行准备后放回）
data/assets/files

